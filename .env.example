# Copy to .env.local and fill in with values from `pnpm supabase status`
# (after `pnpm supabase start`). Never commit .env.local.

# Drizzle connects directly to the local Postgres started by the Supabase CLI.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase client (browser + server) - anon key is safe to expose, service role is not.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
